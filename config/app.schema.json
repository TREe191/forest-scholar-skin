{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-skin.local/schemas/app.schema.json",
  "title": "Codex Skin application configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activeTheme", "appearance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activeTheme": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "appearance": {
      "enum": ["auto", "light", "dark"]
    }
  }
}
