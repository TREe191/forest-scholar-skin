{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-skin.local/schemas/theme.schema.json",
  "title": "Codex Skin theme package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "description",
    "variants",
    "layout",
    "capabilities"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 80
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/variant" },
        "dark": { "$ref": "#/$defs/variant" }
      }
    },
    "layout": {
      "allOf": [
        { "$ref": "#/$defs/packagePath" },
        { "pattern": "\\.json$" }
      ]
    },
    "styles": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/packagePath" },
          { "pattern": "\\.css$" }
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark", "autoAppearance"],
      "properties": {
        "light": { "type": "boolean" },
        "dark": { "type": "boolean" },
        "autoAppearance": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\u0000]+$"
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background"],
      "properties": {
        "background": {
          "allOf": [
            { "$ref": "#/$defs/packagePath" },
            { "pattern": "\\.png$" }
          ]
        }
      }
    }
  }
}
